# College Connect - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your local settings.

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=college_app
DB_PASSWORD=
DB_NAME=college_connect

# Flask Application Security
# Development-only value. Set a fresh secret in Railway; do not deploy this value.
SECRET_KEY=
APP_ENV=development
FLASK_DEBUG=True
PORT=5000

# Railway service variables (set in Railway, never commit secrets):
# APP_ENV=production
# FLASK_DEBUG=False
# SECRET_KEY=<new long random secret>
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# PORT is supplied by Railway; Procfile binds Gunicorn to it.
# DATABASE_URL can reference the Railway MySQL service's MYSQL_URL variable.
# When DATABASE_URL is set, DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, and DB_NAME are unnecessary.

# One-time local MySQL provisioning only; never use these administrator values
# as the Flask application's database account.
# MYSQL_ADMIN_USER=<local administrator username>
# MYSQL_ADMIN_PASSWORD=<local administrator password>
# DB_APP_HOST=localhost

# Optional migration-only demo accounts; all three passwords are required.
# SEED_DEMO_ACCOUNTS=true
# DEMO_ADMIN_PASSWORD=<unique temporary password>
# DEMO_STAFF_PASSWORD=<unique temporary password>
# DEMO_STUDENT_PASSWORD=<unique temporary password>

# One-time Railway bootstrap only. Remove these after the bootstrap completes.
# RUN_INITIAL_BOOTSTRAP=true
# BOOTSTRAP_ADMIN_USERNAME=<initial administrator username>
# BOOTSTRAP_ADMIN_EMAIL=<initial administrator email>
# BOOTSTRAP_ADMIN_PASSWORD=<unique strong password>
